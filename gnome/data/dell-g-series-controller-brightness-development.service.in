[Unit]
Description=Dell G-Series Laptop Keyboard Controller (development checkout)
After=graphical-session.target

[Service]
Type=simple
ExecStart=@PYTHON@ @SERVICE@ --verbose
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=default.target
