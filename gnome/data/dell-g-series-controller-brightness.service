[Unit]
Description=Dell G-Series Laptop Keyboard Controller
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/libexec/dell-g-series-controller/service.py --verbose
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=default.target
